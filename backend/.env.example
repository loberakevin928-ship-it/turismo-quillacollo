# ============================================================
# TURISMO QUILLACOLLO - Variables de entorno del backend
# ------------------------------------------------------------
#  Copia este archivo como ".env" para que el sistema funcione:
#      Windows:  copy .env.example .env
#  (iniciar-sistema.bat lo hace automáticamente si falta)
# ============================================================

# --- Puerto del servidor API ---
PORT=5000

# --- Conexión a MariaDB (XAMPP por defecto) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=turismo_quillacollo

# --- Autenticación JWT ---
JWT_SECRET=cambia-esta-clave-por-una-secreta-en-produccion-quillacollo-2026
JWT_EXPIRES_IN=7d

# --- URL pública del backend (se usa para construir enlaces de imágenes) ---
SERVER_URL=http://localhost:5000